NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGO_URL=mongodb://mongo:27017/commerce_analytics
REDIS_URL=redis://redis:6379
SHOPIFY_WEBHOOK_SECRET=replace-me
TRUST_PROXY=loopback
DEFAULT_STORE_ID=demo-store

# Redis read-through cache and public API token bucket
CACHE_TTL_SECONDS=60
TOKEN_BUCKET_CAPACITY=60
TOKEN_BUCKET_REFILL_PER_SECOND=1

# Scheduled ad-spend sync from the (mock) ads API
MOCK_ADS_URL=http://mock-ads:4100
ADS_CAMPAIGN_IDS=meta-prospecting,meta-retargeting,google-search,google-shopping
ADS_SYNC_CRON=*/30 * * * *

# Daily ROAS alert to Slack (leave the URL empty to disable sending)
SLACK_WEBHOOK_URL=
ROAS_ALERT_THRESHOLD=1.5
ROAS_ALERT_CRON=0 9 * * *
