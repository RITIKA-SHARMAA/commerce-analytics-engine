{
  "name": "commerce-analytics-engine",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce marketing analytics API, workers, and dashboard",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/worker.ts",
    "dev:mock-ads": "tsx watch apps/mock-ads/src/server.ts",
    "build": "npm run build:api && npm run build:worker && npm run build:mock-ads",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "build:mock-ads": "tsc -p apps/mock-ads/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "tsx scripts/seed.ts",
    "dev:dashboard": "npm --prefix apps/dashboard run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.7.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "@typescript-eslint/parser": "^8.8.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0"
  }
}
